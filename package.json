{
  "name": "travel-notebook",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "concurrently --kill-others --names api,web \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run dev -w @travel-notebook/api",
    "dev:web": "npm run dev -w @travel-notebook/web",
    "build": "npm run build --workspaces"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
